# Copy to .env and replace every placeholder. The application refuses to start
# while any of them are still in place.

# The database password. Set before the first `docker compose up`: Postgres
# only reads it when it creates the data directory.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Signs sessions and tokens. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32

# The zone the instance renders dates and days in. One of: America/New_York,
# America/Chicago, America/Denver, America/Phoenix, America/Los_Angeles,
# America/Anchorage, Pacific/Honolulu.
TARE_TZ=America/New_York

# Turn on once this instance is served over https. The session cookie is marked
# Secure, and a browser drops a Secure cookie sent over plain http, so leaving
# this on while testing on http://127.0.0.1 reads as sign-in failing.
COOKIE_SECURE=false

# Where this instance answers, with no trailing slash. Only used to build the
# links that go out by mail, so an instance that sends none can leave it empty.
SITE_URL=

# How many reverse proxies of your own stand in front of the api. The stack
# ships with one, the web container. Raising this past the number really there
# lets a caller choose their own rate-limit bucket.
TRUSTED_PROXY_HOPS=1

# Whether members may hand this instance a health export as a file. On by
# default, because that is how somebody moves a year of history in. Set to
# false and the upload address stops existing and the card for it stops being
# drawn; a phone posting to the sync address is unaffected.
TARE_UPLOADS=true

# Optional. A free key from api.data.gov adds USDA's Branded set to barcode
# lookups, which is tried before Open Food Facts. Without one, lookups use
# Open Food Facts alone, which needs no key.
USDA_API_KEY=

# Optional. Leave empty and the instance sends no mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
