# Copy to .env and replace every placeholder. The application refuses to start
# while any of them are still in place.

# The database password. Set before the first `docker compose up`: Postgres
# only reads it when it creates the data directory.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Signs sessions and tokens. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32

# The zone the instance renders dates and days in.
TARE_TZ=UTC

# Optional. Barcode lookups fall back to nothing without it.
USDA_API_KEY=

# Optional. Leave empty and the instance sends no mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
