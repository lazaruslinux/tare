# Copy to .env and replace every placeholder. The application refuses to start
# while either of the two keys marked CHECKED AT START is still on its example
# value.

# CHECKED AT START. The database password. Set before the first
# `docker compose up`: Postgres only reads it when it creates the data
# directory.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# CHECKED AT START, so an instance never runs on the example value. Sessions
# and mail links are random tokens, not signed, so changing it signs nobody out.
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32

# The zone the instance renders dates and days in. Tare offers US zones only,
# and this is the whole list: America/New_York, America/Chicago,
# America/Denver, America/Phoenix, America/Los_Angeles, America/Anchorage,
# Pacific/Honolulu.
TARE_TZ=America/New_York

# Turn on once this instance is served over https. The session cookie is marked
# Secure, and a browser drops a Secure cookie sent over plain http, so leaving
# this on while testing on http://127.0.0.1 reads as sign-in failing.
COOKIE_SECURE=false

# Where this instance answers, with no trailing slash. Only used to build the
# links that go out by mail, so an instance that sends none can leave it empty.
SITE_URL=

# How many reverse proxies of your own stand in front of the web container. The
# web container is not one of them: it is part of this stack. One TLS proxy,
# which is what docs/DEPLOY.md describes, is 1, and that is the default. Set 0
# when nothing stands in front of the web container, otherwise every caller
# shares one rate-limit bucket. Raising this past the number really there lets a
# caller choose their own bucket.
TRUSTED_PROXY_HOPS=1

# Whether members may hand this instance a health export as a file. On by
# default, because that is how somebody moves a year of history in. Set to
# false and the upload address stops existing and the card for it stops being
# drawn; a phone posting to the sync address is unaffected.
TARE_UPLOADS=true

# Optional. Leave empty and the instance sends no mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Leave true. A local mail catcher used while developing is the one reason to
# turn it off.
SMTP_STARTTLS=true

# Optional. A free FoodData Central key from https://fdc.nal.usda.gov/api-key-signup
# Only the vitamin backfill and the administrator's vitamin picker read it. A
# member's barcode scan never does, whether this is set or not.
USDA_API_KEY=
